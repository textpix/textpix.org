{# Mailing-list sign-up. Uses Brevo when configured in site.yaml. #}
{% if site.brevo.form_action %}
<form class="signup" action="{{ site.brevo.form_action }}" method="post">
  <label for="signup-email-{{ signupId or 'footer' }}">Email address</label>
  <div class="signup-row">
    <input id="signup-email-{{ signupId or 'footer' }}" type="email" name="EMAIL" autocomplete="email" required placeholder="you@example.com">
    {# Brevo's spam trap: must stay empty. #}
    <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="trap">
    <input type="hidden" name="locale" value="en">
    <button type="submit">Join the list</button>
  </div>
</form>
{% elif site.brevo.form_link %}
<p class="signup-fallback"><a class="button" href="{{ site.brevo.form_link }}">Join the mailing list</a></p>
{% else %}
<p class="signup-fallback"><a class="button" href="mailto:{{ site.email }}?subject=Add%20me%20to%20the%20Text%20%2B%20Pix%20list">Email us to join the list</a></p>
{% endif %}
